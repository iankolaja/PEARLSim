surf infinite inf

mat xenon_dummy -1 tmp 959 
  54135.09c    1


%%---surf for triso inside fuel pebbles (spheres)
surf simulation_sphere sph 0 0 0 1000000
surf source_s sph 0 0 0 100.0 %
cell source_c 0 xenon_dummy -source_s



cell c_decay 0   fill u_decay source_s -simulation_sphere
cell c_dummy u_dummy xenon_dummy -infinite
pbed u_decay u_dummy "<point_file>"
cell boundary 0 outside simulation_sphere
set bc 1

set srcrate 0 

src decay g
  sg -1 2


set nps 1000
set seed  42
set acelib  "/global/home/groups/co_nuclear/serpent/xsdata/endfb7/sss_endfb7u.xsdata" "/global/home/groups/co_nuclear/serpent_photon_data/mcplib.xsdata"
set declib  "/global/home/groups/co_nuclear/serpent/xsdata/endfb7/sss_endfb7.dec"
set pdatadir  "/global/home/groups/co_nuclear/serpent_photon_data/photon_data"
set nfylib  "/global/home/groups/co_nuclear/serpent/xsdata/endfb7/sss_endfb7.nfy"
set opti  4
set gcu  -1
set repro  0
set shbuf  0 0
