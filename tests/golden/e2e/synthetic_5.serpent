%
% Carbon pebble core for inner fuel
mat pebgraph  -1.74   rgb  255 127  80     tmp 900  moder  grph 6000
 6000.09c    1.0
%
% -----------------------------------------------------------------------------
% Carbon pebble shell
mat pebshell -1.74   rgb  255 215   0   tmp 900    moder  grph 6000
 6000.09c    1.0
%
% -----------------------------------------------------------------------------
% FLiBe
%NS@KP please check density, temperature changed
mat FLiBe -1.97 rgb 127 255 212 tmp 900
  3007.09c    1.999950
  3006.09c    0.000050
  4009.09c    1
  9019.09c    4
mat FLiBeInC -1.97 rgb 127 255 212 tmp 900
  3007.09c    1.999950
  3006.09c    0.000050
  4009.09c    1
  9019.09c    4
%
% Reflector contains 10 percent flibe %
mat reflector  -1.74 tmp 900 moder  grph 6000  rgb 150 150 150
 6000.09c   -1.0
mat reflectorT -1.74 tmp 900 moder  grph 6000  rgb 150 150 150
 6000.09c   -1.0
mat reflectorB -1.74 tmp 900 moder  grph 6000  rgb 150 150 150
 6000.09c   -1.0
mat reflectorS -1.74 tmp 900 moder  grph 6000 rgb 150 150 150
 6000.09c   -1.0
%
therm grph 900 gre6.18t gre6.20t


% B4C, with assumed 100 at percent B-10 and 1.76 g/cc density per gFHR reactivity control
% with assumption of 70 percent theoretical density
mat B4C -1.76 tmp 900 rgb 100 100 255
 5010.09c 4.000
 6000.09c 1.000


%%%%%%%%%%% Static Geometry %%%%%%%%%%%

set bc 1
%%---plotting geometry
plot 1 807 1000
plot 3 2000 2000 226.0


%%---surf for core
surf infinite inf

%%---surf for triso inside fuel pebbles (spheres)
surf pebble_core_outer sph 0 0 0 1.38 % internal graphite
surf matrix_outer sph 0 0 0 1.80 % graphite matrix maximum radius
surf pebble_outer sph 0 0 0 2.0 % graphite matrix maximum radius

surf core_surf          cylz    0.0 0.0 120.00      60.00    369.47
surf refl_side_surf     cylz    0.0 0.0 180.00      0.0      429.47
surf CB_surf            cylz    0.0 0.0 182.00      0.0      429.47
surf FLiBe_DC_surf      cylz    0.0 0.0 187.00      0.0      429.47
surf RV_surf            cylz    0.0 0.0 191.00      0.0      429.47
surf refl_bottom_surf   cylz    0.0 0.0 120.00      0.0      60.0
surf refl_top_surf      cylz    0.0 0.0 120.00      369.47   429.47

%%--- control rods

surf cr1 cylz  121.6401  39.52330  2.6 60.00 429.47
surf cr2 cylz  75.1777   103.4733  2.6 60.00 429.47
surf cr3 cylz  0.0000    127.9000  2.6 60.00 429.47
surf cr4 cylz -75.1777   103.4733  2.6 60.00 429.47
surf cr5 cylz -121.6401  39.52330  2.6 60.00 429.47
surf cr6 cylz -121.6401 -39.52330  2.6 60.00 429.47
surf cr7 cylz -75.1777  -103.4733  2.6 60.00 429.47
surf cr8 cylz -0.0000   -127.9000  2.6 60.00 429.47
surf cr9 cylz  75.1777  -103.4733  2.6 60.00 429.47
surf cr10 cylz 121.6401 -39.52330  2.6 60.00 429.47

surf rod_insertion_limit pz 300.0

cell cr1        0  B4C   -cr1 rod_insertion_limit
cell cr1_flibe  0  FLiBe -cr1 -rod_insertion_limit
 
cell cr2        0  B4C   -cr2 rod_insertion_limit
cell cr2_flibe  0  FLiBe -cr2 -rod_insertion_limit
 
cell cr3        0  B4C   -cr3 rod_insertion_limit
cell cr3_flibe  0  FLiBe -cr3 -rod_insertion_limit
 
cell cr4        0  B4C   -cr4 rod_insertion_limit
cell cr4_flibe  0  FLiBe -cr4 -rod_insertion_limit
 
cell cr5        0  B4C   -cr5 rod_insertion_limit
cell cr5_flibe  0  FLiBe -cr5 -rod_insertion_limit
 
cell cr6        0  B4C   -cr6 rod_insertion_limit
cell cr6_flibe  0  FLiBe -cr6 -rod_insertion_limit
 
cell cr7        0  B4C   -cr7 rod_insertion_limit
cell cr7_flibe  0  FLiBe -cr7 -rod_insertion_limit
 
cell cr8        0  B4C   -cr8 rod_insertion_limit
cell cr8_flibe  0  FLiBe -cr8 -rod_insertion_limit
 
cell cr9        0  B4C   -cr9 rod_insertion_limit
cell cr9_flibe  0  FLiBe -cr9 -rod_insertion_limit

cell cr10       0  B4C   -cr10 rod_insertion_limit
cell cr10_flibe 0  FLiBe -cr10 -rod_insertion_limit

cell c_pb               0   fill u_pb     -core_surf
cell c_refl_side        0   reflectorS    -refl_side_surf core_surf refl_bottom_surf refl_top_surf cr1 cr2 cr3 cr4 cr5 cr6 cr7 cr8 cr9 cr10
cell c_refl_bottom      0   reflectorB    -refl_bottom_surf
cell c_refl_top         0   reflectorT    -refl_top_surf

cell c_CB               0   CBSS316H      -CB_surf          refl_side_surf
cell c_DC               0   FLiBe         -FLiBe_DC_surf    CB_surf
cell c_RV               0   RVSS316H      -RV_surf          FLiBe_DC_surf

cell out_cell 0 outside     RV_surf

cell c_flibe u_flibe FLiBeInC -infinite





